# Base URL of the backend API, including the /api prefix.
# Leave unset for local dev -- Vite's dev server proxies /api to the
# backend (see vite.config.js), so no cross-origin request ever happens.
# Required in production once the frontend (Cloudflare Pages/Workers) and
# backend (shared hosting) are on different domains.
VITE_API_URL=https://your-backend-domain.com/api
